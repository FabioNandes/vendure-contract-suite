# Copie para .env e ajuste. Nunca versione o .env.
# Lido pelo docker-compose.yml (ambiente) e pela suíte (testes).

# URLs do ambiente local
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api
VENDURE_ADMIN_API_URL=http://localhost:3000/admin-api
VENDURE_DASHBOARD_URL=http://localhost:3000/dashboard

# Credenciais do ambiente descartável. Qualquer valor serve; nenhum deles existe fora da sua
# máquina. Para gerar o segredo do cookie: openssl rand -hex 16
VENDURE_SUPERADMIN_USERNAME=superadmin
VENDURE_SUPERADMIN_PASSWORD=
VENDURE_COOKIE_SECRET=

# Banco (asserções diretas da suíte)
POSTGRES_DB=vendure
POSTGRES_USER=vendure
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
